# Public Supabase project configuration (never a service role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Store in Vercel Environment Variables, never NEXT_PUBLIC or git.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth credentials (store real values only in local env / Vercel env)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-project-url.supabase.co/auth/v1/callback